# npm run dev defaults to demo; npm run build defaults to api when this variable is absent.
# Copy to .env.local for an explicit local override. Never put secrets in VITE_* variables.
VITE_CATALOG_MODE=demo

# Development proxy target; this value stays in the Vite server, not the browser bundle.
BACKEND_URL=http://localhost:8080

# Leave empty for same-origin API requests (recommended).
VITE_API_BASE_URL=
